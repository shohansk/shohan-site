---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import { loadPosts, reader, renderPost } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await loadPosts();
  return posts.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const profile = await reader.singletons.profile.readOrThrow();
const { post, html, minutes } = await renderPost(slug!);
const date = new Date(post.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={`${post.title} — ${profile.name}`} description={post.summary} accent={profile.accent}>
  <Nav cv={profile.cv} home="/" />
  <main class="wrap" style="padding-block:72px 96px;display:flex;flex-direction:column;gap:24px">
    <a href="/#writing" class="mono muted nolink" style="font-size:14px">← cd ../posts</a>
    <span class="mono muted" style="font-size:13px">{date} · {minutes} min read</span>
    <h1 style="font-size:clamp(36px,5vw,60px);font-weight:700;letter-spacing:-.04em;line-height:1.05;max-width:900px">{post.title}</h1>
    {post.summary && <p class="soft" style="font-size:20px;max-width:720px">{post.summary}</p>}
    <article class="prose" set:html={html} />
  </main>
</Base>
